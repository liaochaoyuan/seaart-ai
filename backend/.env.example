# =====================================================================
# SeaArt AI 后端配置模板
# 复制本文件为 .env 后修改；不填密钥则自动进入演示模式(返回示例图)。
# =====================================================================

# ===== 绘图后端切换 =====
#   zhipu  -> 智谱 AI（默认）
#   agnes  -> Agnes AI
# 两个后端可随时切换，前端无需任何改动。
DRAW_BACKEND=zhipu

# =====================================================================
# 后端 1：智谱 AI (BigModel / ZhipuAI)
# =====================================================================
# 控制台 / API Key 获取: https://open.bigmodel.cn/
LLM_API_KEY=your_zhipu_api_key_here

# 智谱 API 基地址（OpenAI 风格 /images/generations 接口）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 绘图模型（必须是 CogView 系列【图像】模型）
#   cogview-3-flash  : 高速（默认）
#   cogview-3-plus   : 高质量 / 高清（Boost HD 首选）
# ⚠️ glm-4-flash / glm-4 / glm-4v 等为【文本 / 多模态】模型，不能绘图，误用会回退演示图。
LLM_MODEL=cogview-3-flash

# =====================================================================
# 后端 2：Agnes AI (apihub.agnes-ai.com)
# =====================================================================
# 控制台 / API Key 获取: https://platform.agnes-ai.com
AGNES_API_KEY=your_agnes_api_key_here

# Agnes API 基地址（OpenAI 兼容 /v1）
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# 绘图模型（必须是图像模型）
#   agnes-image-2.0-flash : 图生图/多图合成专精（支持 seed）
#   agnes-image-2.1-flash : 纯文生图、高信息密度更优（推荐）
# ⚠️ agnes-2.0-flash 是【文本】模型，不能绘图！务必使用 agnes-image-* 系列。
#    内置默认值已设为可出图的 agnes-image-2.0-flash（图像模型），请勿改回文本模型 agnes-2.0-flash。
AGNES_MODEL=agnes-image-2.0-flash
